# Privora Environment Configuration Template
NODE_ENV=development
PORT=4000

# Database (Postgres runs on host)
DATABASE_URL=postgresql://localhost:5432/privora

# Authentication (Access Token Secret must be at least 32 characters)
ACCESS_TOKEN_SECRET=replace_with_at_least_32_characters_random_secret_hex_or_base64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Encryption At Rest (Envelope Encryption KEK)
# Base64 encoded 32-byte (256-bit) key
FILE_KEK_V1=replace_with_base64_encoded_32_byte_key_string
FILE_KEK_CURRENT_VERSION=1

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=privora-vault
S3_ACCESS_KEY=privora_minio_admin
S3_SECRET_KEY=privora_minio_secret_key_123!
S3_REGION=us-east-1

# CORS & Client
CORS_ORIGIN=http://localhost:5173

# Limits & Quotas
MAX_UPLOAD_BYTES=26214400
USER_QUOTA_BYTES=524288000
